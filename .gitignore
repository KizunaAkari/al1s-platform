# Private workspace documentation. Source repositories are maintained separately.
/docs/
/backups/

# Local runtime data, evidence and developer tools.
/data/
/artifacts/
/.agents/
/.codex/
/.codex-diagnostics/
/.tool-cache/
/.terminal-assets/
/.test-tmp/
/Ultralytics/
/*.pt

# Reproducible dependencies, build outputs and test caches.
node_modules/
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.gradle/
.idea/
build/
dist/
coverage/
.coverage
htmlcov/
*.tsbuildinfo
*.egg-info/
*.log

# Local credentials/configuration; retain distributable examples.
.env
.env.*
*.env
*.env.*
!.env.example
!.env.*.example
!*.env.example
!*.env.*.example
!.env.template
!.env.*.template
!*.env.template
!*.env.*.template
*.key
*.pem
*.pfx
*.p12
*.jks
*.keystore
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.sqlite3-wal
*.sqlite3-shm
**/local.properties

# Account directories and runtime credentials have no source role.
/al1s-deployment/bots/llbot-data/
/al1s-deployment/compose/tls/generated/*
!/al1s-deployment/compose/tls/generated/.gitkeep
/al1s-deployment/compose/mosquitto/config/dynamic-security.json
/al1s-deployment/packages/

# Credential files also stay private when stored outside runtime directories.
*.token
*_token.txt
*-token.txt
token.txt
credential
identity.json
last-known-good.json
discord-runtime.json
signing.properties
keystore.properties
*.sqlite-wal
