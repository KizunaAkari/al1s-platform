# Docker control center
AGENT_TOKEN=maa-demo-token
PUBLIC_BASE_URL=http://127.0.0.1:8000
# URL reachable from the terminal board for cached NPU image downloads.
TERMINAL_DEPLOY_PUBLIC_URL=http://192.168.5.3:8000
TERMINAL_DEPLOYER_PORT=8767
TERMINAL_IMAGE_TAG=al1s-terminal-agent:npu-arm64

# Script failure email notification. Copy this file to .env and fill these values.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=automation@example.com
SMTP_PASSWORD=replace-with-an-app-password
SMTP_FROM=automation@example.com
SMTP_STARTTLS=true
SMTP_SSL=false
FAILURE_EMAIL_TO=owner@example.com
