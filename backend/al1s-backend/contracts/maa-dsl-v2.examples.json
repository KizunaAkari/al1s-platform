{
  "core_actions": [
    "back", "cleanup", "course_schedule", "feedback", "screenshot", "home", "task_view",
    "launch_app", "smart_swipe", "start", "wait", "wait_click", "wait_image",
    "wait_text", "click_text", "tap", "swipe", "wait_random", "recognize_execute"
  ],
  "valid": {
    "version": 2,
    "script_type": "module_process",
    "target": {
      "application_package": "com.example.game",
      "screen_size": { "width": 1080, "height": 1920 }
    },
    "cleanup_on_finish": false,
    "steps": [
      { "action": "wait", "seconds": 1 },
      { "action": "tap", "x": 100, "y": 200 },
      { "action": "swipe", "x1": 10, "y1": 20, "x2": 300, "y2": 400, "duration_ms": 350 },
      { "action": "wait_text", "text": "领取[奖励]", "wait_after_execution_seconds": 1.25 }
    ]
  },
  "valid_complex": {
    "version": 2,
    "script_type": "module_process",
    "target": { "application_package": "com.example.game" },
    "cleanup_on_finish": false,
    "steps": [{
      "action": "wait_click",
      "template_base64": "data:image/png;base64,YQ==",
      "template_rect": { "x": 10, "y": 20, "width": 30, "height": 40 },
      "threshold": 0.85,
      "click_mode": "match_center",
      "click_count": 2,
      "click_interval_ms": 120,
      "wait_after_execution_seconds": 2.5,
      "image_branches": [{
        "id": "fallback",
        "template_base64": "data:image/png;base64,Yg==",
        "threshold": 0.75,
        "click_mode": "match_center"
      }]
    }, {
      "action": "wait_image",
      "template_base64": "data:image/png;base64,YQ==",
      "consecutive_match_count": 3,
      "poll_interval_seconds": 1
    }]
  },
  "invalid": {
    "version": 2,
    "script_type": "module_process",
    "target": { "application_package": "com.example.game" },
    "steps": [{ "action": 42 }]
  },
  "invalid_typed": {
    "version": 2,
    "script_type": "module_process",
    "target": {
      "application_package": "com.example.game",
      "screen_size": { "width": 1080, "height": 1920 }
    },
    "steps": [{ "action": "tap", "x": "not-a-number", "y": 200 }]
  },
  "invalid_complex": {
    "version": 2,
    "script_type": "module_process",
    "target": { "application_package": "com.example.game" },
    "steps": [{ "action": "wait_click", "threshold": "high", "click_count": 2 }]
  },
  "invalid_branch": {
    "version": 2,
    "script_type": "module_process",
    "target": { "application_package": "com.example.game" },
    "steps": [{
      "action": "wait_click",
      "template_base64": "data:image/png;base64,YQ==",
      "click_mode": "match_center",
      "image_branches": [{ "template_base64": "data:image/png;base64,Yg==", "threshold": "high" }]
    }]
  }
}
