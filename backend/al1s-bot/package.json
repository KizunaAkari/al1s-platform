{
  "name": "al1s-plachta",
  "version": "0.1.0",
  "private": true,
  "description": "AL-1S Discord mention bridge powered by Sapphire and OneBot 11",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run build && npm test"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@sapphire/framework": "5.5.0",
    "discord.js": "14.27.0",
    "dotenv": "17.4.2",
    "global-agent": "3.0.0",
    "undici": "6.29.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/global-agent": "3.0.0",
    "@types/node": "26.2.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
