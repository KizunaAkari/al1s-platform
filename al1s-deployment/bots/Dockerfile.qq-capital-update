ARG BASE_IMAGE=al1s-plachta:qq-visual-2.4.0-r2
FROM ${BASE_IMAGE}
USER root
COPY --from=backend al1s/freqtrade/ /opt/al1s/al1s/freqtrade/
COPY --from=backend al1s/adapters/postgres/freqtrade_models.py al1s/adapters/postgres/freqtrade_repository.py /opt/al1s/al1s/adapters/postgres/
COPY --from=backend al1s/meme_workshop/runtime_identity.py al1s/meme_workshop/runtime_probe.py /opt/al1s/al1s/meme_workshop/
COPY --from=backend al1s/components/contracts.py al1s/components/operations.py /opt/al1s/al1s/components/
RUN python -c "import hashlib,json,pathlib; root=pathlib.Path('/opt/al1s/al1s'); p=pathlib.Path('/opt/al1s/runtime-manifest.json'); m=json.loads(p.read_text()); m.update(runtime_version='2.5.0',qq_freqtrade_capital_v1=True,source_sha256=hashlib.sha256(b''.join(f.read_bytes() for f in sorted(root.rglob('*.py')))).hexdigest()); p.write_text(json.dumps(m))"
LABEL org.al1s.runtime-version=2.5.0 org.al1s.qq-freqtrade-capital=1
RUN python -m al1s.meme_workshop.runtime_probe
