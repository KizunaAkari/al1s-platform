# Standalone local-development fallback only. Docker Compose reads Bot business
# settings from the runtime file generated by the AL-1S control center.

# Discord public identifiers
DISCORD_APPLICATION_ID=1439231483326894160
DISCORD_OWNER_USER_IDS=577928624884154368
DISCORD_GUILD_IDS=1439045928785940598

# Leave empty to monitor every accessible text channel in the allowed guilds.
DISCORD_CHANNEL_IDS=
# Only real @everyone messages from these channels are sent to QQ_TARGET_GROUP_ID.
DISCORD_GROUP_CHANNEL_IDS=

# Secret: obtain from Discord Developer Portal > Bot. Never commit this value.
DISCORD_TOKEN=

# QQ private-message destination. This is the receiving QQ number.
QQ_TARGET_USER_ID=
QQ_TARGET_GROUP_ID=

# OneBot 11 HTTP endpoint inside the Compose network.
ONEBOT_BASE_URL=http://llbot:3000

# Local development only. AL-1S generates and synchronizes this value in Docker.
ONEBOT_ACCESS_TOKEN=

# Worker behavior
FORWARD_PREFIX=[Discord]
FORWARD_RETRY_ATTEMPTS=3
FORWARD_TIMEOUT_MS=10000
DEDUPE_TTL_SECONDS=86400
LOG_LEVEL=info
HEALTH_HOST=0.0.0.0
HEALTH_PORT=3100

# Read-only history scanner. Set a channel ID before history:scan.
HISTORY_SCAN_CHANNEL_ID=
HISTORY_SCAN_LIMIT=50

# LLBot container settings
LLBOT_VERSION=latest
# Windows Docker Desktop normally follows the host VPN/TUN without these.
# These optional variables affect HTTP traffic, but are not a replacement for
# TUN routing of the Discord Gateway WebSocket.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,llbot,discord-worker,al1s-core
NODE_USE_ENV_PROXY=0
