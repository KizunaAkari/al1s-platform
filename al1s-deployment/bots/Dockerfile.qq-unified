# The base is the verified current QQ release, including the unchanged isolated
# quant and Freqtrade environments. Build tooling verifies its immutable ID.
ARG QQ_BASE=al1s-plachta:qq-unified-reproducible-root-20261102
FROM ${QQ_BASE} AS complete
USER root

COPY requirements.qq.lock /tmp/requirements.qq.lock
RUN python -m pip install --no-cache-dir -r /tmp/requirements.qq.lock \
 && python -m pip check

RUN rm -rf /opt/al1s-astrbot-src /opt/al1s-astrbot-venv /opt/al1s-astrbot-plugins \
           /opt/al1s/al1s/bot_ai /tmp/requirements.astrbot.lock
COPY --from=backend source-manifest.json /tmp/qq-source-manifest.json
COPY --from=backend al1s/ /opt/al1s/al1s/
COPY qq-headed-supervisord.conf /etc/al1s-qq-supervisord.conf

RUN python -c "import json,hashlib,pathlib; root=pathlib.Path('/opt/al1s/al1s'); p=pathlib.Path('/opt/al1s/runtime-manifest.json'); m=json.loads(p.read_text()); source=hashlib.sha256(b''.join(f.read_bytes() for f in sorted(root.rglob('*.py')))).hexdigest(); assert source == json.loads(pathlib.Path('/tmp/qq-source-manifest.json').read_text())['source_sha256']; m.update(runtime_version='2.13.0',qq_comfy_drawing_v1=True,source_sha256=source,requirements_sha256=hashlib.sha256(pathlib.Path('/tmp/requirements.qq.lock').read_bytes()+pathlib.Path('/tmp/requirements.quant.lock').read_bytes()+pathlib.Path('/opt/al1s/requirements.freqtrade.lock').read_bytes()).hexdigest()); p.write_text(json.dumps(m))"
RUN python -m al1s.meme_workshop.runtime_probe \
 && python -c "import al1s.meme_workshop.runtime_main"

# The verified unified base was already flattened after removing the legacy runtime.
FROM complete
ENV PATH=/opt/al1s-venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin PYTHONPATH=/opt/al1s PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 AL1S_MEME_ROLE=qq PROTOCOL_MODE=pmhq DISPLAY=:99 LIBGL_ALWAYS_SOFTWARE=1 TZ=Asia/Shanghai SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
LABEL org.al1s.bot-role=qq org.al1s.runtime-version=2.13.0 org.al1s.native-version=8.3.2 org.al1s.qq-protocol-mode=pmhq \
      org.al1s.qq-quant=1 org.al1s.qq-freqtrade=1 org.al1s.qq-freqtrade-futures=1 \
      org.al1s.qq-freqtrade-visual=1 org.al1s.qq-freqtrade-capital=1 org.al1s.qq-command-replies=1 \
      org.al1s.qq-ai=1 org.al1s.qq-ai-personas=1 org.al1s.qq-ai-network-routes=1 org.al1s.qq-comfy-drawing=1 \
      org.al1s.qq-ai-group-reply=1 org.al1s.qq-ai-smart-reply=1
USER root
WORKDIR /app/llbot
ENTRYPOINT ["python","-m","al1s.bots.qq_headed.startup"]
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 CMD ["python","-m","al1s.meme_workshop.healthcheck"]
