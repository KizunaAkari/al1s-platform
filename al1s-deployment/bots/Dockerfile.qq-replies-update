ARG BASE_IMAGE=al1s-plachta:qq-quant-reply-20261029
FROM ${BASE_IMAGE}
USER root
COPY --from=backend al1s/quant/ /opt/al1s/al1s/quant/
COPY --from=backend al1s/freqtrade/ /opt/al1s/al1s/freqtrade/
COPY --from=backend al1s/trading_replies/ /opt/al1s/al1s/trading_replies/
COPY --from=backend al1s/adapters/postgres/quant_settings.py al1s/adapters/postgres/freqtrade_repository.py al1s/adapters/postgres/trading_reply_models.py al1s/adapters/postgres/trading_reply_repository.py /opt/al1s/al1s/adapters/postgres/
COPY --from=backend al1s/api/quant.py al1s/api/freqtrade.py al1s/api/trading_replies.py /opt/al1s/al1s/api/
COPY --from=backend al1s/meme_workshop/runtime.py al1s/meme_workshop/runtime_identity.py al1s/meme_workshop/runtime_probe.py /opt/al1s/al1s/meme_workshop/
COPY --from=backend al1s/components/contracts.py al1s/components/operations.py /opt/al1s/al1s/components/
RUN python -c "import hashlib,json,pathlib; root=pathlib.Path('/opt/al1s/al1s'); p=pathlib.Path('/opt/al1s/runtime-manifest.json'); m=json.loads(p.read_text()); m.update(runtime_version='2.6.0',qq_command_replies_v1=True,source_sha256=hashlib.sha256(b''.join(f.read_bytes() for f in sorted(root.rglob('*.py')))).hexdigest()); p.write_text(json.dumps(m))"
LABEL org.al1s.runtime-version=2.6.0 org.al1s.qq-command-replies=1
RUN python -m al1s.meme_workshop.runtime_probe
