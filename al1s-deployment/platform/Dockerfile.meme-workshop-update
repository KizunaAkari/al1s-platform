# Consistent source snapshot on the verified 0054 platform dependencies and checked frontend dist.
# Named contexts: backend=backend/al1s-backend, frontend=al1s-frontend/dist.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
COPY --from=backend --chown=al1s:al1s al1s /app/al1s
COPY --from=backend --chown=al1s:al1s migrations /app/migrations
COPY --from=frontend --chown=al1s:al1s . /app/frontend/
RUN python -c "from al1s.main import app; from al1s.adapters.postgres.meme_models import MemeSendGateRow; from al1s.api.meme_proxy import router; assert len(router.routes)==2; app.openapi()"
