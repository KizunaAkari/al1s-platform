# Paths must refer to the registered deployment. Filled values belong in private .env.component-host.
AL1S_COMPONENT_HOST='{"url":"https://component-maintenance:8012","token":"REPLACE_WITH_PRIVATE_COMPONENT_CREDENTIAL","ca_file":"/run/al1s/editor-relay-ca.crt"}'
AL1S_COMPONENT_MAINTENANCE_IMAGE=al1s-component-maintenance:local
AL1S_COMPONENT_ROOT=/opt/al1s/al1s-deployment
AL1S_COMPONENT_DEPLOYMENT_SOURCE=/opt/al1s/al1s-deployment
AL1S_COMPONENT_CONFIG=/opt/al1s/al1s-deployment/packages/components/runtime/container.json
AL1S_COMPONENT_PLATFORM_HOSTNAME=al1s.local
