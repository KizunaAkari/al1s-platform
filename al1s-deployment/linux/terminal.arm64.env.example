AL1S_TERMINAL_PLATFORM_URL=https://al1s.local
AL1S_TERMINAL_IMAGE=al1s-terminal-next:replace-with-verified-tag
# Supply these to Compose with --env-file, not only the container env_file.
# Verify existing identity/queue files before changing mounts; these are target paths,
# not instructions to create a new empty identity or move existing files.
AL1S_TERMINAL_DATA_DIR_HOST=/run/media/mmcblk1p8/al1s/data
AL1S_TERMINAL_ADB_HOME_HOST=/run/media/mmcblk1p8/al1s/adb-home
AL1S_TERMINAL_MODEL_DIR_HOST=/run/media/mmcblk1p8/al1s/models
AL1S_TERMINAL_CERT_DIR_HOST=/run/media/mmcblk1p8/al1s/certs
AL1S_TERMINAL_DISPLAY_NAME=AL-1S RK3576 Terminal
AL1S_TERMINAL_AGENT_VERSION=0.1.0
AL1S_TERMINAL_REGISTRATION_CODE=replace-with-one-time-registration-code

# Keep this path aligned with the read-only /certs mount in compose.arm64.yaml.
AL1S_TERMINAL_TLS_CA_FILE=/certs/platform-ca.crt

# Use a resolvable terminal hostname; do not persist its DHCP address.
# Editor video requires all three settings and a certificate trusted by the browser.
# The certificate SAN must include this hostname. Do not use ws:// with HTTPS.
# AL1S_TERMINAL_SCRCPY_PUBLIC_URL=wss://replace-with-terminal-hostname.local:8766
# AL1S_TERMINAL_SCRCPY_TLS_CERT_FILE=/certs/editor.crt
# AL1S_TERMINAL_SCRCPY_TLS_KEY_FILE=/certs/editor.key
