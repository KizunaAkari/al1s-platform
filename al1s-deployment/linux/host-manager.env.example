# Install only after reviewing host/container ownership. Never put secrets in the image.
AL1S_HOST_CONTAINER=al1s-terminal-linux
AL1S_HOST_MANAGER_DATA=/var/lib/al1s-host-manager
# Must match the restricted deployer's root; verify old deployment paths before installing.
AL1S_DEPLOY_ROOT=/run/media/mmcblk1p8/al1s
# Match the actual operator-reviewed Compose/env locations; no automatic directory move.
AL1S_DEPLOY_COMPOSE=/run/media/mmcblk1p8/al1s/deployment/compose.arm64.yaml
AL1S_DEPLOY_ENV_FILE=/run/media/mmcblk1p8/al1s/deployment/terminal.arm64.env
# These must match the running terminal's Compose bind mounts, not old defaults.
# If data is elsewhere, also permit that exact path in a systemd ReadWritePaths drop-in.
AL1S_DEPLOY_DATA_DIR=/run/media/mmcblk1p8/al1s/data
AL1S_DEPLOY_ADB_HOME=/run/media/mmcblk1p8/al1s/adb-home
AL1S_DEPLOY_MODEL_DIR=/run/media/mmcblk1p8/al1s/models
AL1S_DEPLOY_CERT_DIR=/run/media/mmcblk1p8/al1s/certs
# Loopback by default. Set a private bind address only with TLS and firewall restrictions.
AL1S_HOST_MANAGER_BIND=127.0.0.1
AL1S_HOST_MANAGER_PORT=8771
AL1S_HOST_MANAGER_CERT=/etc/al1s/host-manager.crt
AL1S_HOST_MANAGER_KEY=/etc/al1s/host-manager.key
AL1S_HOST_MANAGER_TOKEN_FILE=/etc/al1s/host-manager.token
# Optional platform-published upgrades. Configure the registered Linux terminal UUID.
# Only HTTPS origin; never include an API path or credentials in the URL.
# AL1S_UPGRADE_PLATFORM_ORIGIN=https://platform.example:8443
# AL1S_UPGRADE_TERMINAL_ID=replace-with-registered-terminal-uuid
# AL1S_UPGRADE_PLATFORM_CA=/etc/al1s/platform-ca.crt
# Download uses this host's existing management token; platform maps it to the same UUID.
# Before enabling: root and artifact directories must be root-owned, not group/world writable.
