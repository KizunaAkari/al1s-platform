AL1S_POSTGRES_DATABASE=al1s
# Set a private password of at least 12 characters. Empty disables management access.
AL1S_ADMIN_PASSWORD=
# Keep true for HTTPS. Only local HTTP development may explicitly set false.
AL1S_ADMIN_COOKIE_SECURE=true
# Optional browser-facing HTTP(S) origin for task links in notifications (no credentials).
AL1S_PLATFORM_PUBLIC_URL=
# Optional browser-facing native UI address; no token or URL credentials.
AL1S_LLBOT_WEBUI_URL=
AL1S_POSTGRES_USER=al1s
AL1S_POSTGRES_PASSWORD=change-me-set-a-unique-database-password
AL1S_S3_BUCKET=al1s-platform
AL1S_S3_ACCESS_KEY=al1s-local
AL1S_S3_SECRET_KEY=al1s-s3-local-change-me
AL1S_NOTIFICATION_MASTER_KEY=al1s-local-notification-master-key-change-before-production
AL1S_OFFLINE_PERMIT_SIGNING_KEY=replace-with-a-random-secret-at-least-32-bytes
AL1S_MQTT_USERNAME=al1s-platform
AL1S_MQTT_PASSWORD=al1s-mqtt-local-change-me
AL1S_MQTT_PUBLISHER_USERNAME=al1s-platform-publisher
AL1S_MQTT_PUBLISHER_PASSWORD=al1s-mqtt-publisher-local-change-me
AL1S_MQTT_SESSION_SIGNING_KEY=al1s-local-mqtt-session-signing-key-change-before-production
AL1S_MQTT_BIND_ADDRESS=127.0.0.1
AL1S_MQTT_LOCAL_PORT=1883
AL1S_MQTT_PUBLIC_HOST=127.0.0.1
AL1S_MQTT_PUBLIC_PORT=1883
AL1S_MQTT_TLS_ENABLED=false
AL1S_MQTT_PUBLIC_TLS_ENABLED=false
AL1S_BACKEND_PORT=8100
AL1S_FRONTEND_PORT=8180
## Optional bot control helper (disabled until explicitly deployed).
AL1S_BOT_CONTROL_URL=
AL1S_BOT_CONTROL_TOKEN=
AL1S_CONTROL_QQ_CONTAINER=
AL1S_CONTROL_DISCORD_CONTAINER=
AL1S_DOCKER_SOCKET_GID=
AL1S_CONTROL_NETWORK=al1s-next-control
AL1S_CONTROL_DOCKER_VERSION=1.45
